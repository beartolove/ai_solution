# ─────────────────────────────────────────────
# AI 翻譯設定（選用）
# 複製本檔為「.env」後填入，重新啟動程式即生效。
# .env 內含金鑰，請勿分享或上傳到 Git。
# ─────────────────────────────────────────────

# API 端點（Azure OpenAI / APIM 閘道填到 /openai 之前為止）
# Azure AI Foundry：可直接貼專案端點 https://<名稱>.services.ai.azure.com/api/projects/<專案>
#   程式會自動改用 https://<名稱>.services.ai.azure.com/openai/v1，LLM_MODEL 填部署名稱
LLM_ENDPOINT=https://your-gateway.azure-api.net/your-path

# 金鑰
LLM_API_KEY=

# 部署名稱（azure 格式）或模型名稱（openai 格式）
LLM_MODEL=

# API 格式：azure  → {端點}/openai/deployments/{模型}/chat/completions?api-version=...
#           openai → {端點}/chat/completions（Azure OpenAI v1 請把端點填到 .../openai/v1）
LLM_API_STYLE=azure
LLM_API_VERSION=2024-10-21

# 金鑰放在哪個標頭：Azure OpenAI 為 api-key；APIM 閘道常用 Ocp-Apim-Subscription-Key；OpenAI 用 Authorization
LLM_KEY_HEADER=api-key

# 推理型模型可設 minimal / low 加快速度（模型不支援時請留空）
LLM_REASONING_EFFORT=

# 遮蔽詞（選用，逗號分隔）：Azure 部署若設了封鎖清單（例如競品名稱），這些詞送給 AI 前會先換成代號、回來再換回原詞
# 程式遇到被擋時也會自動找出並記住（存在 data\llm_mask.json，可在設定頁清除）
LLM_MASK_WORDS=

# 同時送出的批次數（1～8），太高可能被限流
LLM_CONCURRENCY=4
